{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "generateNotesCmd": "if [ -f release-summary.md ]; then cat release-summary.md; fi",
        "verifyReleaseCmd": "if [ -n \"$RELEASE_VERSION\" ]; then test '${nextRelease.version}' = \"$RELEASE_VERSION\"; fi",
        "prepareCmd": "sed -i.bak '/^name = \"entanglement\"[[:space:]]*$/ {n; s/^version = \"[^\"]*\"[[:space:]]*$/version = \"${nextRelease.version}\"/;}' Cargo.toml Cargo.lock && rm Cargo.toml.bak Cargo.lock.bak"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["Cargo.toml", "Cargo.lock"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "dist/*" }],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
