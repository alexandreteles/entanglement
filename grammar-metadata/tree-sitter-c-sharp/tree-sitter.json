{
  "grammars": [{
    "name": "c-sharp",
    "camelcase": "CSharp",
    "scope": "source.cs",
    "path": ".",
    "file-types": ["cs", "csx"],
    "highlights": "queries/highlights.scm",
    "tags": "queries/tags.scm",
    "injection-regex": "^(cs|csharp|c-sharp|c#)$"
  }],
  "metadata": {
    "version": "0.24.0",
    "license": "MIT",
    "description": "C# grammar for tree-sitter",
    "links": {"repository": "https://github.com/tree-sitter/tree-sitter-c-sharp"}
  }
}
