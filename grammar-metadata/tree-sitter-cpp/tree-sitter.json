{
  "grammars": [{
    "name": "cpp",
    "camelcase": "CPP",
    "scope": "source.cpp",
    "path": ".",
    "file-types": ["cc", "cpp", "cxx", "c++", "C", "hh", "hpp", "hxx", "h++", "H", "ipp", "tpp", "tcc", "inl", "cppm", "ccm", "cxxm", "c++m", "ixx"],
    "highlights": "queries/highlights.scm",
    "injections": "queries/injections.scm",
    "tags": "queries/tags.scm",
    "injection-regex": "^(cc|cpp|c\\+\\+)$"
  }],
  "metadata": {
    "version": "0.23.4",
    "license": "MIT",
    "description": "C++ grammar for tree-sitter",
    "links": {"repository": "https://github.com/tree-sitter/tree-sitter-cpp"}
  }
}
